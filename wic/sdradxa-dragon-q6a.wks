# SD card image for Radxa Dragon Q6A (QCM6490) — UEFI boot with A/B rootfs
#
# Layout:
#   Partition 1 — EFI System Partition (FAT32, 64 MiB)
#     UEFI loads EFI/BOOT/BOOTAA64.EFI (kernel + bundled initramfs).
#     slot.conf selects rootfs_a or rootfs_b at boot.
#
#   Partition 2 — rootfs_a (ext4, 2 GiB) — A/B slot A, populated at flash time
#   Partition 3 — rootfs_b (ext4, 2 GiB) — A/B slot B, empty at flash time
#   Partition 4 — data    (ext4, 512 MiB) — persistent user data (/mnt/sdcard)

# --no-fstab-update on ALL partitions: wic hardcodes /dev/mmcblk0pN entries
# into /etc/fstab (from --ondisk mmcblk0), but the SD card enumerates as
# mmcblk1 on this board (mmcblk0 is the non-populated eMMC slot).
# The initramfs selects the rootfs by GPT partition name via sysfs.
#
# --part-type EF00: marks partition 1 as "EFI System" in GPT. Without this,
# wic creates it as type 0700 (Microsoft basic data), which spec-compliant
# UEFI firmware will not recognize as an ESP.
part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label efi --active --align 1024 --size 64M --no-fstab-update --part-type EF00
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs_a --align 1024 --fixed-size 2048M --no-fstab-update
part --ondisk mmcblk0 --fstype=ext4 --label rootfs_b --align 1024 --fixed-size 2048M --no-fstab-update
part --ondisk mmcblk0 --fstype=ext4 --label data --align 1024 --fixed-size 512M --no-fstab-update

bootloader --ptable gpt --timeout 0
