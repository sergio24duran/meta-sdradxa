[Unit]
Description=BPK field capture - button-triggered libcamera stills for dataset
Requires=mnt-ufscard.mount
After=mnt-ufscard.mount
ConditionPathExists=/usr/bin/bpk-field-capture

[Service]
Type=simple
ExecStart=/usr/bin/bpk-field-capture shot 98 falling 99 pull-up
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
