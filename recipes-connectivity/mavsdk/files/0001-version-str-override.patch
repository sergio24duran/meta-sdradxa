--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -15,17 +15,21 @@ if (NOT MAVLINK_DIALECT)
     set(MAVLINK_DIALECT "ardupilotmega")
 endif()
 
-execute_process(
-    COMMAND git describe --abbrev=8 --dirty --always --tags
-    WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
-    OUTPUT_VARIABLE VERSION_STR
-    OUTPUT_STRIP_TRAILING_WHITESPACE
-    RESULT_VARIABLE GITVER
-)
-
-if (NOT GITVER EQUAL "0")
-    message(STATUS "No git version found. Falling back to empty version no")
-    set(VERSION_STR "0.0.0")
+# Allow the version to be supplied directly (-DVERSION_STR=v3.17.1) for
+# source trees exported without a .git dir, e.g. Yocto do_unpack.
+if (NOT VERSION_STR)
+    execute_process(
+        COMMAND git describe --abbrev=8 --dirty --always --tags
+        WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
+        OUTPUT_VARIABLE VERSION_STR
+        OUTPUT_STRIP_TRAILING_WHITESPACE
+        RESULT_VARIABLE GITVER
+    )
+
+    if (NOT GITVER EQUAL "0")
+        message(STATUS "No git version found. Falling back to empty version no")
+        set(VERSION_STR "0.0.0")
+    endif()
 endif()
 
 message(STATUS "Version: ${VERSION_STR}")
