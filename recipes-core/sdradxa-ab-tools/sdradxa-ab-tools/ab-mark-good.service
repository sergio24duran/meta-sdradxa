[Unit]
Description=Mark current A/B boot slot as good
After=multi-user.target
# When a counted kernel entry is being assessed, boot-complete.target gates
# systemd-bless-boot: the kernel candidate is only blessed once the rootfs
# slot has also proven good, so both "good" marks land at the same instant.
Before=boot-complete.target

[Service]
Type=oneshot
ExecStart=/usr/bin/ab-mark-good
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target boot-complete.target
